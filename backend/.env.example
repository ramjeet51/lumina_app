# Used by a backend process started directly on the host.
# Docker Compose uses the repository-root .env instead.

DB_HOST=your-rds-hostname.rds.amazonaws.com
DB_PORT=3306
DB_USER=lumina_app
DB_PASSWORD=change-me
DB_NAME=lumina_db

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT=10
