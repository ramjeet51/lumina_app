# Leave empty so the browser calls same-origin /api.
# The Next.js server proxies /api to FastAPI.
NEXT_PUBLIC_API_URL=

# Only for `next dev` when the API is not proxied:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Where the Next.js server should proxy /api, /health, and /ready.
# Docker Compose sets this to http://backend:8000 at image build time.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
