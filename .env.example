# Copy to .env on the application server. Do not commit .env.
# Docker Compose reads this file. It is not baked into the images.

DB_HOST=your-rds-hostname.rds.amazonaws.com
DB_PORT=3306
DB_USER=lumina_app
DB_PASSWORD=change-me
DB_NAME=lumina_db

JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated browser origins, or * to allow any origin.
CORS_ORIGINS=*

# Host port for the website. The API stays on the internal Docker network.
HTTP_PORT=80

LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT=10
